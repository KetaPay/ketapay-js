{
  "name": "@ketapay/checkout",
  "version": "0.1.0-beta.2",
  "description": "Official browser library for KetaPay checkout",
  "license": "MIT",
  "keywords": [
    "ketapay",
    "escrow",
    "payments",
    "checkout",
    "nigeria",
    "browser"
  ],
  "homepage": "https://github.com/KetaPay/ketapay-js#readme",
  "bugs": {
    "url": "https://github.com/KetaPay/ketapay-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KetaPay/ketapay-js.git"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./checkout.js": "./dist/checkout.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "sync-catalogue": "node scripts/sync-catalogue.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=json --outputFile.json=reports/unit.json",
    "test:catalogue": "vitest run test/catalogue-coverage.test.ts",
    "test:e2e": "playwright test",
    "test:report": "node scripts/test-summary.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
